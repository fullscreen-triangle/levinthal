# Stage directories
stage_*/

# Test data directories
spectra/
logs/
test_data/
data/
output/

# The bare `data/` above has no leading slash, so git applies it at
# EVERY directory level. That silently swallows application source and
# deployed assets. Each web app's data directory is re-included here.
#
# Add a negation pair below when a new app gains a data/ directory --
# the failure is invisible: `git status` does not report ignored files.

# cytochrome: lesson corpus + GLB markers, imported at build time.
!cytochrome/src/data/
!cytochrome/src/data/**

# shakespear: chart JSON/CSV fetched at runtime by D3ChartHelpers.js.
# Missing these does not fail the build -- the charts just 404 in prod.
!shakespear/public/data/
!shakespear/public/data/**

# enzymes/web: the frozen KEGG + Reactome corpus, fetched at runtime.
# Missing this does not fail the build -- the corpus line just reads
# "unavailable" and the corpus cells report no data.
!enzymes/web/public/data/
!enzymes/web/public/data/**

# enzymes/webtool: the same corpus for the pre-Vite static version.
!enzymes/webtool/data/
!enzymes/webtool/data/**

