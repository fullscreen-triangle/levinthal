\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {The host's union bound is the additive relaxation of the ladder's law, and it goes vacuous as chains lengthen.} \textbf  {(A)}~The two forms on identical retentions drawn from $[0.5,0.99]$, $4000$ trials per point. The multiplicative form stays near unity; the additive form falls, crosses zero between three and four stages, and enters the shaded region. A lower bound on a quantity known to lie in $[0,1]$ that has gone negative is true and says nothing. \textbf  {(B)}~The fraction of trials on which the additive form is vacuous: zero at two stages, $0.515$ at four, $0.996$ at eight. Vacuity is the common case by four stages. \textbf  {(C)}~The mean gap between the two forms, which grows monotonically from $0.44$ to $2.05$ across the range measured. \textbf  {(D)}~The gap over chain length and retention. It vanishes at high retention and short chains---where the union bound is nearly tight---and grows in both directions away from that corner. The comparison is not a criticism: the additive form is stated as a bound and carries an injectivity hypothesis, and what is measured here is how much it gives up.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:panel4}{{4}{8}{\textbf {The host's union bound is the additive relaxation of the ladder's law, and it goes vacuous as chains lengthen.} \textbf {(A)}~The two forms on identical retentions drawn from $[0.5,0.99]$, $4000$ trials per point. The multiplicative form stays near unity; the additive form falls, crosses zero between three and four stages, and enters the shaded region. A lower bound on a quantity known to lie in $[0,1]$ that has gone negative is true and says nothing. \textbf {(B)}~The fraction of trials on which the additive form is vacuous: zero at two stages, $0.515$ at four, $0.996$ at eight. Vacuity is the common case by four stages. \textbf {(C)}~The mean gap between the two forms, which grows monotonically from $0.44$ to $2.05$ across the range measured. \textbf {(D)}~The gap over chain length and retention. It vanishes at high retention and short chains---where the union bound is nearly tight---and grows in both directions away from that corner. The comparison is not a criticism: the additive form is stated as a bound and carries an injectivity hypothesis, and what is measured here is how much it gives up}{figure.4}{}}
\newlabel{fig:panel4@cref}{{[figure][4][]4}{[1][7][]8}{}{}{}}
