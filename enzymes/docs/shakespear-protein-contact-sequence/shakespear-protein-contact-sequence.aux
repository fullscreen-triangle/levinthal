\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Radius is a resolution parameter, and it runs in the direction opposite to the one we predicted.} \textbf  {(A)}~Pairs of items whose derived powers agree to $10^{-9}$, against radius. Identification rises from zero at radius $0$ to $26$ at radius $3$. Our stated prediction was that a coarse radius would identify more; the measurement is the reverse and \cref  {rem:res-inverted} records the correction. \textbf  {(B)}~The mechanism, which is why the direction is what it is. Mean pairwise ball overlap (solid) rises monotonically from $0.000$ to $0.763$, while the number of distinct powers (dashed, right axis) falls from $138$ to $114$. Balls of radius $0$ are disjoint singletons and each item minimises over its own edges; balls of large radius coincide, so distinct items minimise over the same edge set and their powers converge. The overlap is plotted beside the count because a count without its mechanism would leave the direction unexplained. \textbf  {(C)}~Six individual power trajectories on one chain as the radius grows. Traces that begin apart come together and then flatten, which is the per-item form of the aggregate in~(B). \textbf  {(D)}~The resolution surface: derived power over item and radius. The surface is ridged at small radius, where items differ, and flattens along the radius axis as the balls merge.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:panel2}{{2}{8}{\textbf {Radius is a resolution parameter, and it runs in the direction opposite to the one we predicted.} \textbf {(A)}~Pairs of items whose derived powers agree to $10^{-9}$, against radius. Identification rises from zero at radius $0$ to $26$ at radius $3$. Our stated prediction was that a coarse radius would identify more; the measurement is the reverse and \cref {rem:res-inverted} records the correction. \textbf {(B)}~The mechanism, which is why the direction is what it is. Mean pairwise ball overlap (solid) rises monotonically from $0.000$ to $0.763$, while the number of distinct powers (dashed, right axis) falls from $138$ to $114$. Balls of radius $0$ are disjoint singletons and each item minimises over its own edges; balls of large radius coincide, so distinct items minimise over the same edge set and their powers converge. The overlap is plotted beside the count because a count without its mechanism would leave the direction unexplained. \textbf {(C)}~Six individual power trajectories on one chain as the radius grows. Traces that begin apart come together and then flatten, which is the per-item form of the aggregate in~(B). \textbf {(D)}~The resolution surface: derived power over item and radius. The surface is ridged at small radius, where items differ, and flattens along the radius axis as the balls merge}{figure.2}{}}
\newlabel{fig:panel2@cref}{{[figure][2][]2}{[1][7][]8}{}{}{}}
