      "reachable_split_size": 4,
      "keys_differ": true,
      "terminal_sets_identical": true,
      "reachable_sets_identical": false,
      "passed": true,
      "note": "Reachable sets differ by the intermediate (a,*): this is the signal V1.5 uses.  Terminal residue alone cannot distinguish the two categorical structures."
