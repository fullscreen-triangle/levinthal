\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {The peptide linkage is shortened and rotationally restricted exactly as coordinate sharing predicts, folding buries the majority of solvent-accessible surface, and a real folded structure realises long-range contacts an extended chain cannot.} (\textbf  {A})~Measured bond length of the peptide C(=O)--N linkage, $1.33$~\r A, against a typical single C--N bond, $1.47$~\r A. The ten-percent shortening is the structural signature of a linkage stabilised by a shared, delocalised coordinate rather than by a purely single-bond configuration. (\textbf  {B})~Rotational barrier about the same two linkages on a linear axis: $79$~kJ/mol for the peptide bond against $12$~kJ/mol for an ordinary single bond, a near-sevenfold elevation consistent with the depth deficit available from sharing being forfeited on rotation out of plane. (\textbf  {C})~Mean solvent-accessible surface area per residue in an extended reference chain, $175$~\r A$^2$, against a folded globular domain, $45$~\r A$^2$: folding buries roughly three-quarters of the surface an extended chain would expose, the direct measure of positions brought into contact with other positions of the same chain rather than with solvent. (\textbf  {D})~Contact density surface reconstructed from the real, externally computed ground-truth contact map of a folded cytochrome P450 structure (152 contacts over a 60-element reduced representation), binned over residue pairs $(i,j)$. The off-diagonal ridges are contacts between positions distant in sequence, realisable only by compaction and absent from any extended-chain baseline of the same length.}}{11}{figure.2}\protected@file@percent }
\newlabel{fig:respanel2}{{2}{11}{\textbf {The peptide linkage is shortened and rotationally restricted exactly as coordinate sharing predicts, folding buries the majority of solvent-accessible surface, and a real folded structure realises long-range contacts an extended chain cannot.} (\textbf {A})~Measured bond length of the peptide C(=O)--N linkage, $1.33$~\AA , against a typical single C--N bond, $1.47$~\AA . The ten-percent shortening is the structural signature of a linkage stabilised by a shared, delocalised coordinate rather than by a purely single-bond configuration. (\textbf {B})~Rotational barrier about the same two linkages on a linear axis: $79$~kJ/mol for the peptide bond against $12$~kJ/mol for an ordinary single bond, a near-sevenfold elevation consistent with the depth deficit available from sharing being forfeited on rotation out of plane. (\textbf {C})~Mean solvent-accessible surface area per residue in an extended reference chain, $175$~\AA $^2$, against a folded globular domain, $45$~\AA $^2$: folding buries roughly three-quarters of the surface an extended chain would expose, the direct measure of positions brought into contact with other positions of the same chain rather than with solvent. (\textbf {D})~Contact density surface reconstructed from the real, externally computed ground-truth contact map of a folded cytochrome P450 structure (152 contacts over a 60-element reduced representation), binned over residue pairs $(i,j)$. The off-diagonal ridges are contacts between positions distant in sequence, realisable only by compaction and absent from any extended-chain baseline of the same length}{figure.2}{}}
\newlabel{fig:respanel2@cref}{{[figure][2][]2}{[1][10][]11}{}{}{}}
