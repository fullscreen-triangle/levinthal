\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Isoform-specific activation partition-depth offsets and predicted rate ratios.} (\textbf  {A}) Bar chart of $\Delta \mathcal  {M}_I$ offsets relative to the CYP3A4 baseline for ten major drug-metabolising isoforms; dashed line at zero (CYP3A4 reference); CYP2D6 carries $\Delta \mathcal  {M}= +0.08$ ($k_{2D6}/k_{3A4} = e^{-0.08} \approx 0.923$) and CYP2C9 carries $\Delta \mathcal  {M}= +0.05$ ($k_{2C9}/k_{3A4} \approx 0.951$), reflecting their tighter selectivity filters~\citep  {zanger2013}. (\textbf  {B}) Predicted rate ratios $k_I/k_{3A4}$ (coloured circles) versus literature $k_{\rm  cat}$ ratios from kinetic studies (black squares with error bars); all predictions lie within the reported spread, confirming that scalar $\Delta \mathcal  {M}_I$ offsets capture the essential isoform-to-isoform rate differences. (\textbf  {C}) Three-dimensional rate-ratio surface in ($\Delta \mathcal  {M}$, substrate molecular weight, $k_I/k_{3A4}$) space; the penalty increases with both substrate size and partition-depth offset, providing a quantitative map of isoform-specific rate suppression.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:panel05}{{5}{6}{\textbf {Isoform-specific activation partition-depth offsets and predicted rate ratios.} (\textbf {A}) Bar chart of $\Delta \depth _I$ offsets relative to the CYP3A4 baseline for ten major drug-metabolising isoforms; dashed line at zero (CYP3A4 reference); CYP2D6 carries $\Delta \depth = +0.08$ ($k_{2D6}/k_{3A4} = e^{-0.08} \approx 0.923$) and CYP2C9 carries $\Delta \depth = +0.05$ ($k_{2C9}/k_{3A4} \approx 0.951$), reflecting their tighter selectivity filters~\citep {zanger2013}. (\textbf {B}) Predicted rate ratios $k_I/k_{3A4}$ (coloured circles) versus literature $k_{\rm cat}$ ratios from kinetic studies (black squares with error bars); all predictions lie within the reported spread, confirming that scalar $\Delta \depth _I$ offsets capture the essential isoform-to-isoform rate differences. (\textbf {C}) Three-dimensional rate-ratio surface in ($\Delta \depth $, substrate molecular weight, $k_I/k_{3A4}$) space; the penalty increases with both substrate size and partition-depth offset, providing a quantitative map of isoform-specific rate suppression}{figure.caption.7}{}}
\newlabel{fig:panel05@cref}{{[figure][5][]5}{[1][4][]6}{}{}{}}
