\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Kinetic properties of each catalytic transition.} (\textbf  {A}) $\Delta \mathcal  {M}$ bar chart colour-coded by category: ET steps (red), chemical steps (blue). (\textbf  {B}) Rate constants $k_i = \nu _\mathrm  {floor} \exp (-\Delta \mathcal  {M}_i)$ on a logarithmic scale; all rates span $\approx 10^{9}$--$10^{10}$\,s$^{-1}$. (\textbf  {C}) Individual timescales $\tau _i = 1/k_i$ in picoseconds; the slowest intrinsic step is substrate binding ($\Delta \mathcal  {M} = 0.92$). (\textbf  {D}) Three-dimensional scatter of $(\Delta \mathcal  {M}, \log _{10}k, \log _{10}\tau )$ triples for all eight transitions (plasma colourmap).}}{3}{figure.caption.6}\protected@file@percent }
\newlabel{fig:panel02_state_properties}{{3}{3}{\textbf {Kinetic properties of each catalytic transition.} (\textbf {A}) $\Delta \mathcal {M}$ bar chart colour-coded by category: ET steps (red), chemical steps (blue). (\textbf {B}) Rate constants $k_i = \nu _\mathrm {floor} \exp (-\Delta \mathcal {M}_i)$ on a logarithmic scale; all rates span $\approx 10^{9}$--$10^{10}$\,s$^{-1}$. (\textbf {C}) Individual timescales $\tau _i = 1/k_i$ in picoseconds; the slowest intrinsic step is substrate binding ($\Delta \mathcal {M} = 0.92$). (\textbf {D}) Three-dimensional scatter of $(\Delta \mathcal {M}, \log _{10}k, \log _{10}\tau )$ triples for all eight transitions (plasma colourmap)}{figure.caption.6}{}}
\newlabel{fig:panel02_state_properties@cref}{{[figure][3][]3}{[1][2][]3}{}{}{}}
