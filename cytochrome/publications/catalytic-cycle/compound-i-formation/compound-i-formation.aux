\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Compound I Spectroscopic Validation Against Rittle-Green Data.} (\textbf  {A})~Predicted vs experimental scatter for eight independent observables (M\"{o}ssbauer $\delta $, $\Delta E_Q$; EPR $g$; UV-Vis Soret; total spin; oxidation potential; lifetime at two temperatures), with the diagonal $y = x$ as reference. All predictions cluster on or near the diagonal. (\textbf  {B})~Per-observable relative error (horizontal bars), coloured by error magnitude (red-yellow-green). The 20\%-error reference line shows the framework's overall agreement. (\textbf  {C})~Pie chart of agreement: 8/8 observables within 20\% of experimental values, supporting the framework's prediction across all available Compound~I spectroscopy. (\textbf  {D})~Three-dimensional bar landscape of predicted (orange) versus experimental (blue) values per observable, with x-axis encoding observable identity. The bilinear bars confirm prediction-experimental agreement on the same scale across all eight observables.}}{11}{figure.caption.9}\protected@file@percent }
\newlabel{fig:spectroscopy}{{8}{11}{\textbf {Compound I Spectroscopic Validation Against Rittle-Green Data.} (\textbf {A})~Predicted vs experimental scatter for eight independent observables (M\"{o}ssbauer $\delta $, $\Delta E_Q$; EPR $g$; UV-Vis Soret; total spin; oxidation potential; lifetime at two temperatures), with the diagonal $y = x$ as reference. All predictions cluster on or near the diagonal. (\textbf {B})~Per-observable relative error (horizontal bars), coloured by error magnitude (red-yellow-green). The 20\%-error reference line shows the framework's overall agreement. (\textbf {C})~Pie chart of agreement: 8/8 observables within 20\% of experimental values, supporting the framework's prediction across all available Compound~I spectroscopy. (\textbf {D})~Three-dimensional bar landscape of predicted (orange) versus experimental (blue) values per observable, with x-axis encoding observable identity. The bilinear bars confirm prediction-experimental agreement on the same scale across all eight observables}{figure.caption.9}{}}
\newlabel{fig:spectroscopy@cref}{{[figure][8][]8}{[1][10][]11}{}{}{}}
