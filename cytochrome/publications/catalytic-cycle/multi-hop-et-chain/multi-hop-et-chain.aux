\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {GLB-Grounded Apparatus Integration Audit.} Composition of Paper~2.5 (GLB-based structural input) with Layer~5 of the apparatus stack: the productive cytochrome P450 GLB serves as the analyte; the heme-Fe coordinate at $(17.26, 11.53, 24.76)$~\r A{} (taken DIRECTLY from the GLB scene graph by \texttt  {find\_iron()}) anchors the chain; the upstream cofactors NADPH, FAD, FMN are placed along the extension axis at literature distances $4$, $4$, $14$~\r A. (\textbf  {A})~Cofactor occupancies under the shader pipeline at the final frame $t = 800$~fs. The electron has traversed the chain: NADPH occupancy is depleted; heme occupancy dominates ($> 0.7$). (\textbf  {B})~Electron centroid advance along the chain over $0$--$800$~fs. The trajectory begins at NADPH ($\sim 0$~\r A) and ends at heme ($\sim 22$~\r A), crossing FAD and FMN waypoints in sequence. The advance is monotonic. (\textbf  {C})~Apparatus integration checks (validation script 12). All seven inter-layer consistency checks pass: Fe anchored to GLB, chain length matches literature, heme dominates final frame, centroid monotonic, centroid traverses $\geq 50\%$ of the chain, Marcus $\lambda $ within $20\%$ of canonical $0.85$~eV, GLB atom count matches Paper~2.5 baseline ($146$). (\textbf  {D})~Three-dimensional view of the GLB-anchored cofactor cluster: NADPH (blue), FAD (orange), FMN (green), heme (red), with the real GLB Fe position marked by a black cross. The black line traces the chain extension axis. This is the analyte that enters Layer~5; the resulting visualisations are \cref  {fig:electron_visualisations}.}}{15}{figure.caption.12}\protected@file@percent }
\newlabel{fig:glb_shader_integration}{{9}{15}{\textbf {GLB-Grounded Apparatus Integration Audit.} Composition of Paper~2.5 (GLB-based structural input) with Layer~5 of the apparatus stack: the productive cytochrome P450 GLB serves as the analyte; the heme-Fe coordinate at $(17.26, 11.53, 24.76)$~\AA {} (taken DIRECTLY from the GLB scene graph by \texttt {find\_iron()}) anchors the chain; the upstream cofactors NADPH, FAD, FMN are placed along the extension axis at literature distances $4$, $4$, $14$~\AA . (\textbf {A})~Cofactor occupancies under the shader pipeline at the final frame $t = 800$~fs. The electron has traversed the chain: NADPH occupancy is depleted; heme occupancy dominates ($> 0.7$). (\textbf {B})~Electron centroid advance along the chain over $0$--$800$~fs. The trajectory begins at NADPH ($\sim 0$~\AA ) and ends at heme ($\sim 22$~\AA ), crossing FAD and FMN waypoints in sequence. The advance is monotonic. (\textbf {C})~Apparatus integration checks (validation script 12). All seven inter-layer consistency checks pass: Fe anchored to GLB, chain length matches literature, heme dominates final frame, centroid monotonic, centroid traverses $\geq 50\%$ of the chain, Marcus $\lambda $ within $20\%$ of canonical $0.85$~eV, GLB atom count matches Paper~2.5 baseline ($146$). (\textbf {D})~Three-dimensional view of the GLB-anchored cofactor cluster: NADPH (blue), FAD (orange), FMN (green), heme (red), with the real GLB Fe position marked by a black cross. The black line traces the chain extension axis. This is the analyte that enters Layer~5; the resulting visualisations are \cref {fig:electron_visualisations}}{figure.caption.12}{}}
\newlabel{fig:glb_shader_integration@cref}{{[figure][9][]9}{[1][13][]15}{}{}{}}
