\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {The $d_{\mathrm  {C}}= 4$ Catalytic Efficiency Prediction.} (\textbf  {A})~$\log _{10}(k_{\mathrm  {cat}}/K_{\mathrm  {M}})$ versus categorical distance $d_{\mathrm  {C}}$ from the partition-landscape relation $\log _{10}(k_{\mathrm  {cat}}/K_{\mathrm  {M}}) \approx 10 - d_{\mathrm  {C}}$. The CPR--CYP3A4 chain at $d_{\mathrm  {C}}= 4$ predicts $\log _{10}(k_{\mathrm  {cat}}/K_{\mathrm  {M}}) = 6$, marked by the red dashed cross-hairs. (\textbf  {B})~Measured $\log _{10}(k_{\mathrm  {cat}}/K_{\mathrm  {M}})$ for four representative CYP3A4 substrates (testosterone, midazolam, erythromycin, nifedipine). The vertical red dashed line marks the framework's $10^6$ M$^{-1}$s$^{-1}$ prediction; all four substrates cluster within an order of magnitude of the prediction. (\textbf  {C})~Per-substrate log deviation from prediction. Three of four substrates lie above prediction (positive deviation, green); one below (red). All deviations are within 1 log unit, supporting the framework's parameter-free prediction. (\textbf  {D})~Three-dimensional bar landscape of $\log _{10}(k_{\mathrm  {cat}}/K_{\mathrm  {M}})$ over engineered $d_{\mathrm  {C}}$ values $(2, \ldots  , 7)$ and the four real substrates. The bilinear surface reflects the linear relation $\log _{10}(k_{\mathrm  {cat}}/K_{\mathrm  {M}}) = 10 - d_{\mathrm  {C}}$; bar colour encodes $d_{\mathrm  {C}}$ on the viridis scale.}}{16}{figure.caption.13}\protected@file@percent }
\newlabel{fig:dc4_efficiency}{{10}{16}{\textbf {The $\dC = 4$ Catalytic Efficiency Prediction.} (\textbf {A})~$\log _{10}(\kcat /\KM )$ versus categorical distance $\dC $ from the partition-landscape relation $\log _{10}(\kcat /\KM ) \approx 10 - \dC $. The CPR--CYP3A4 chain at $\dC = 4$ predicts $\log _{10}(\kcat /\KM ) = 6$, marked by the red dashed cross-hairs. (\textbf {B})~Measured $\log _{10}(\kcat /\KM )$ for four representative CYP3A4 substrates (testosterone, midazolam, erythromycin, nifedipine). The vertical red dashed line marks the framework's $10^6$ M$^{-1}$s$^{-1}$ prediction; all four substrates cluster within an order of magnitude of the prediction. (\textbf {C})~Per-substrate log deviation from prediction. Three of four substrates lie above prediction (positive deviation, green); one below (red). All deviations are within 1 log unit, supporting the framework's parameter-free prediction. (\textbf {D})~Three-dimensional bar landscape of $\log _{10}(\kcat /\KM )$ over engineered $\dC $ values $(2, \ldots , 7)$ and the four real substrates. The bilinear surface reflects the linear relation $\log _{10}(\kcat /\KM ) = 10 - \dC $; bar colour encodes $\dC $ on the viridis scale}{figure.caption.13}{}}
