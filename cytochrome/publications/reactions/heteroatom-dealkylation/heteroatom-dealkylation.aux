\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Validation summary for Paper~7. All 8 validation scripts PASS: BDE scaling, N-dealkylation rate, KIE prediction, S-oxidation direct transfer, N-oxide formation, rate hierarchy ordering, carbinolamine lability, and competitive inhibition by ketoconazole ($K_i < 100\,\mathrm  {nM}$). Predicted rates consistent with literature ranges for CYP3A4 and CYP2D6 substrates.}}{4}{figure.caption.10}\protected@file@percent }
\newlabel{fig:p7-valid}{{8}{4}{Validation summary for Paper~7. All 8 validation scripts PASS: BDE scaling, N-dealkylation rate, KIE prediction, S-oxidation direct transfer, N-oxide formation, rate hierarchy ordering, carbinolamine lability, and competitive inhibition by ketoconazole ($K_i < 100\,\mathrm {nM}$). Predicted rates consistent with literature ranges for CYP3A4 and CYP2D6 substrates}{figure.caption.10}{}}
\newlabel{fig:p7-valid@cref}{{[figure][8][]8}{[1][4][]4}{}{}{}}
