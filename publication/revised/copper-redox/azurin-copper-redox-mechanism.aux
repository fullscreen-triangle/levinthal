\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Azurin Protein Structure with Electron Transfer Trajectory in Biological Context.} \textbf  {(Top Left)} Full protein structure (PDB: 4AZU) showing 128-residue azurin backbone as gray ribbon with electron trajectory superimposed. Protein adopts characteristic $\beta $-barrel fold (blue loops indicate $\beta $-sheets) with Cu active site buried $\sim $7$\sim $\r Abelow surface. \textbf  {(Top Right)} Zoomed view of copper active site showing tetrahedral coordination geometry. Cu center (orange sphere) coordinated by four ligands in distorted tetrahedral arrangement: His46 (blue, N$_\delta $ coordination), His117 (blue, N$_\epsilon $ coordination), Cys112 (yellow, S$_\gamma $ coordination), Met121 (green, S$_\delta $ coordination). \textbf  {(Bottom Left)} Protein backbone rendered as ribbon diagram showing secondary structure. N-terminus (green triangle, bottom) and C-terminus (red triangle, top) mark polypeptide chain direction. \textbf  {(Bottom Right)} Time evolution with velocity vectors showing electron motion through 3D space. Trajectory plotted as colored spheres (blue $\to $ red gradient, 0--160$\sim $fs) with Cu center marked by orange sphere at origin. }}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:protein_structure}{{2}{7}{\textbf {Azurin Protein Structure with Electron Transfer Trajectory in Biological Context.} \textbf {(Top Left)} Full protein structure (PDB: 4AZU) showing 128-residue azurin backbone as gray ribbon with electron trajectory superimposed. Protein adopts characteristic $\beta $-barrel fold (blue loops indicate $\beta $-sheets) with Cu active site buried $\sim $7$\sim $\AA below surface. \textbf {(Top Right)} Zoomed view of copper active site showing tetrahedral coordination geometry. Cu center (orange sphere) coordinated by four ligands in distorted tetrahedral arrangement: His46 (blue, N$_\delta $ coordination), His117 (blue, N$_\epsilon $ coordination), Cys112 (yellow, S$_\gamma $ coordination), Met121 (green, S$_\delta $ coordination). \textbf {(Bottom Left)} Protein backbone rendered as ribbon diagram showing secondary structure. N-terminus (green triangle, bottom) and C-terminus (red triangle, top) mark polypeptide chain direction. \textbf {(Bottom Right)} Time evolution with velocity vectors showing electron motion through 3D space. Trajectory plotted as colored spheres (blue $\to $ red gradient, 0--160$\sim $fs) with Cu center marked by orange sphere at origin}{figure.caption.3}{}}
\newlabel{fig:protein_structure@cref}{{[figure][2][]2}{[1][6][]7}}
