\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Categorical Quantum State Trajectory in (n, $\ell $, m, s) Space.} \textbf  {(Top Left)} 3D trajectory through categorical coordinate space showing evolution of principal quantum number $n$, angular momentum $\ell $, and magnetic quantum number $m$ over 160$\sim $fs. \textbf  {(Top Right)} Principal quantum number $n$ and angular momentum $\ell $ evolution. $n$ remains constant at 1 for 0--90$\sim $fs, then jumps to 2 at 90$\sim $fs (vertical blue line, 1 transition). \textbf  {(Bottom Left)} Magnetic quantum number $m$ and spin $s$ evolution. $m$ transitions from $0 \to -1$ at 10$\sim $fs (orange curve, 1 transition). \textbf  {(Bottom Right)} Phase space projection showing $(n, \ell )$ trajectory. System begins at $(1, 2)$ (blue star) and ends at $(2, 2)$ (red star), tracing L-shaped path through phase space. \textbf  {Total Transitions:} 3 discrete quantum state changes over 160$\sim $fs: (i) $\ell $: 0 $\to $ 2 (10$\sim $fs), (ii) $m$: 0 $\to $ -1 (10$\sim $fs), (iii) $n$: 1 $\to $ 2 (90$\sim $fs). }}{4}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:categorical}{{1}{4}{\textbf {Categorical Quantum State Trajectory in (n, $\ell $, m, s) Space.} \textbf {(Top Left)} 3D trajectory through categorical coordinate space showing evolution of principal quantum number $n$, angular momentum $\ell $, and magnetic quantum number $m$ over 160$\sim $fs. \textbf {(Top Right)} Principal quantum number $n$ and angular momentum $\ell $ evolution. $n$ remains constant at 1 for 0--90$\sim $fs, then jumps to 2 at 90$\sim $fs (vertical blue line, 1 transition). \textbf {(Bottom Left)} Magnetic quantum number $m$ and spin $s$ evolution. $m$ transitions from $0 \to -1$ at 10$\sim $fs (orange curve, 1 transition). \textbf {(Bottom Right)} Phase space projection showing $(n, \ell )$ trajectory. System begins at $(1, 2)$ (blue star) and ends at $(2, 2)$ (red star), tracing L-shaped path through phase space. \textbf {Total Transitions:} 3 discrete quantum state changes over 160$\sim $fs: (i) $\ell $: 0 $\to $ 2 (10$\sim $fs), (ii) $m$: 0 $\to $ -1 (10$\sim $fs), (iii) $n$: 1 $\to $ 2 (90$\sim $fs)}{figure.caption.2}{}}
\newlabel{fig:categorical@cref}{{[figure][1][]1}{[1][3][]4}{}{}{}}
