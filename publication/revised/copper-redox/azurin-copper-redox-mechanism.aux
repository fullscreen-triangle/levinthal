\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {3D Electron Probability Cloud Evolution During Cu(I) $\to $ Cu(II) Transfer.} Four snapshots showing volumetric probability density $|\psi (\mathbf  {r}, t)|^2$ rendered as 3D voxel clouds on 41$\times $41$\times $74 grid spanning $\pm $20~\r A(xy-plane) and $\pm $37~\r A(z-axis). \textbf  {(Far Left) Initial State (t = 0$\sim $fs):} Electron localized in compact cloud centered at origin with dimensions $\sim $3~\r A$\times $ 3~\r A$\times $ 2~\r A(xyz). Cloud exhibits cubic symmetry with four primary lobes (green-yellow voxels) extending along $\pm x$ and $\pm y$ directions, characteristic of Cu(I) 3d$^{10}$ 4s$^1$ ground state. \textbf  {(Center Left) Early Transfer (t = 50$\sim $fs):} Cloud maintains compact structure with minimal spatial displacement ($\Delta x \approx 0.5$~\r Afrom origin). Slight asymmetry emerges: positive-x lobe (transfer direction) extends to 4~\r Awhile negative-x lobe retracts to 2~\r A, indicating wavefunction polarization toward acceptor site. \textbf  {(Center Right) Late Transfer (t = 110$\sim $fs):} Cloud expands significantly: dimensions increase to $\sim $6~\r A$\times $ 5~\r A$\times $ 4~\r A, volume $\sim $8$\times $ larger than initial state. Expansion reflects electronic excitation to higher-energy orbital with larger spatial extent. \textbf  {(Far Right) Time-Lapse Overlay (All States Combined):} Composite visualization showing superposition of all 17 measurement snapshots (t = 0, 10, 20, \ldots  , 160$\sim $fs).}}{10}{figure.caption.8}\protected@file@percent }
\newlabel{fig:electron_cloud}{{5}{10}{\textbf {3D Electron Probability Cloud Evolution During Cu(I) $\to $ Cu(II) Transfer.} Four snapshots showing volumetric probability density $|\psi (\mathbf {r}, t)|^2$ rendered as 3D voxel clouds on 41$\times $41$\times $74 grid spanning $\pm $20~\AA (xy-plane) and $\pm $37~\AA (z-axis). \textbf {(Far Left) Initial State (t = 0$\sim $fs):} Electron localized in compact cloud centered at origin with dimensions $\sim $3~\AA $\times $ 3~\AA $\times $ 2~\AA (xyz). Cloud exhibits cubic symmetry with four primary lobes (green-yellow voxels) extending along $\pm x$ and $\pm y$ directions, characteristic of Cu(I) 3d$^{10}$ 4s$^1$ ground state. \textbf {(Center Left) Early Transfer (t = 50$\sim $fs):} Cloud maintains compact structure with minimal spatial displacement ($\Delta x \approx 0.5$~\AA from origin). Slight asymmetry emerges: positive-x lobe (transfer direction) extends to 4~\AA while negative-x lobe retracts to 2~\AA , indicating wavefunction polarization toward acceptor site. \textbf {(Center Right) Late Transfer (t = 110$\sim $fs):} Cloud expands significantly: dimensions increase to $\sim $6~\AA $\times $ 5~\AA $\times $ 4~\AA , volume $\sim $8$\times $ larger than initial state. Expansion reflects electronic excitation to higher-energy orbital with larger spatial extent. \textbf {(Far Right) Time-Lapse Overlay (All States Combined):} Composite visualization showing superposition of all 17 measurement snapshots (t = 0, 10, 20, \ldots , 160$\sim $fs)}{figure.caption.8}{}}
\newlabel{fig:electron_cloud@cref}{{[figure][5][]5}{[1][9][]10}{}{}{}}
